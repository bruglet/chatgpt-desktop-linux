+async fn register_host_app(connection: &Connection) -> Result<()> {
+    let Some(desktop_name) = std::env::var_os("CHROME_DESKTOP") else {
+        return Ok(());
+    };
+    let Some(desktop_name) = desktop_name.to_str() else {
+        return Ok(());
+    };
+    let app_id = desktop_name.strip_suffix(".desktop").unwrap_or(desktop_name);
+    if app_id.is_empty() {
+        return Ok(());
+    }
+    register_host_app_id(connection, app_id).await
+}
+
+async fn register_host_app_id(connection: &Connection, app_id: &str) -> Result<()> {
+    let registry = match Proxy::new(
+        connection,
+        PORTAL_SERVICE,
+        PORTAL_PATH,
+        HOST_REGISTRY_INTERFACE,
+    )
+    .await
+    {
+        Ok(proxy) => proxy,
+        Err(error) if host_registry_unavailable(&error) => return Ok(()),
+        Err(error) => return Err(error).context("host portal Registry is unavailable"),
+    };
+    let options: HashMap<&str, Value<'_>> = HashMap::new();
+    let result: std::result::Result<(), zbus::Error> =
+        registry.call("Register", &(app_id, options)).await;
+    match result {
+        Ok(()) => Ok(()),
+        Err(error) if host_registry_unavailable(&error) => Ok(()),
+        Err(error) => Err(error).context("host portal Registry registration failed"),
+    }
+}
+
+fn host_registry_unavailable(error: &zbus::Error) -> bool {
+    match error {
+        zbus::Error::InterfaceNotFound => true,
+        zbus::Error::MethodError(name, _, _) => matches!(
+            name.as_str(),
+            "org.freedesktop.DBus.Error.UnknownInterface"
+                | "org.freedesktop.DBus.Error.UnknownMethod"
+        ),
+        _ => false,
+    }
+}
